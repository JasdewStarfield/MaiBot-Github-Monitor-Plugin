{
  "manifest_version": 2,
  "id": "jasdewstarfield.github-monitor-plugin",
  "version": "2.0.0",
  "name": "GitHub 监控插件",
  "description": "定期扫描 GitHub 仓库的新提交并推送到 MaiBot 群聊",
  "author": {
    "name": "Jasdew Starfield",
    "url": "https://github.com/JasdewStarfield"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/JasdewStarfield/MaiBot-Github-Monitor-Plugin",
    "homepage": "https://github.com/JasdewStarfield/MaiBot-Github-Monitor-Plugin",
    "documentation": "https://github.com/JasdewStarfield/MaiBot-Github-Monitor-Plugin#readme",
    "issues": "https://github.com/JasdewStarfield/MaiBot-Github-Monitor-Plugin/issues"
  },
  "host_application": {
    "min_version": "1.4.3",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.22.1",
    "max_version": "2.22.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.14.3,<4"
    },
    {
      "type": "python_package",
      "name": "pydantic",
      "version_spec": ">=2.11.7,<3"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "bell"
    }
  },
  "capabilities": [
    "send.text",
    "chat.get_stream_by_group_id",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
